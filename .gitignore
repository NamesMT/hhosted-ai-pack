node_modules/

# Tracked: the server definitions, and a UI uploaded through Settings → Interface, so a
# clone (or a backup) keeps the panel the way it was set up. home-hosted's own state
# (secrets, logs, backups) stays out, and the servers it supervises write into data/.
state/*
!state/servers.config.json
!state/.ui/
data/

# pnpm's virtual store bookkeeping
.pnpm-store/
