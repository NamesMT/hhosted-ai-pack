{
  "name": "hhosted-ai-pack",
  "version": "0.1.0",
  "private": true,
  "description": "A home AI pack — the OmniRoute and 9router gateways, plus dsh — supervised by home-hosted.",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "up": "home-hosted up --home ./state",
    "down": "home-hosted down --home ./state",
    "restart": "home-hosted restart --home ./state",
    "status": "home-hosted status --home ./state",
    "set-password": "home-hosted set-password --home ./state",
    "set-token": "home-hosted set-token --home ./state",
    "migrate": "home-hosted migrate --home ./state",
    "postinstall": "node scripts/patch-9router.js --optional",
    "patch:9router": "node scripts/patch-9router.js",
    "check:patch": "node scripts/patch-9router.js --check",
    "test:patch": "node --test scripts/patches/processScan.test.cjs"
  },
  "dependencies": {
    "9router": "0.5.75",
    "@deepseek-ai/dsh": "~0.1.7-rc.2",
    "home-hosted": "^0.4.1",
    "omniroute": "^3.8.50"
  }
}
